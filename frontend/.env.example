# 이 파일을 .env 로 복사해서 쓴다.
#   cp frontend/.env.example frontend/.env
#
# NEXT_PUBLIC_* 은 Next.js 가 빌드 타임에 문자열로 치환한다.
# 값을 바꾸면 dev 서버를 재시작해야 반영된다.

# 백엔드 API 주소. 비어 있으면 상대 경로로 요청이 나가 조용히 실패한다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8060

# 목 데이터 모드 (dev-plan P0-6).
# 백엔드가 준비되기 전까지 true. 실 API 를 붙일 때 false 로 내린다.
# 미설정 시 기본값은 true 다 — 즉 실 API 를 쓰려면 반드시 명시해야 한다.
NEXT_PUBLIC_USE_MOCK=true

# 카카오맵 JavaScript 키 (P3-1 지도 · decisions.md 4.71). 머신마다 넣는다.
# 브라우저에 그대로 드러나는 값이다 — 막는 수단은 키가 아니라 도메인 등록이다.
#   1) developers.kakao.com → 앱 → [앱 설정] > [앱] > [플랫폼 키] → JavaScript 키
#   2) 그 키의 JavaScript SDK 도메인에 http://localhost:3001 과 배포 도메인을 등록한다
#   3) [제품 설정] > [카카오맵] > [활성화 설정] 을 ON 으로 (2024-12 부터 신규 앱에 필요)
# 비워 두면 지도 자리에 MAP_KEY_MISSING 카드가 뜬다. 테스트·빌드는 키 없이 통과한다.
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=

# 이 파일을 .env 로 복사해서 쓴다.
#   cp frontend/.env.example frontend/.env
#
# NEXT_PUBLIC_* 은 Next.js 가 빌드 타임에 문자열로 치환한다.
# 값을 바꾸면 dev 서버를 재시작해야 반영된다.

# 백엔드 API 주소. 비어 있으면 상대 경로로 요청이 나가 조용히 실패한다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8060

# 목 데이터 모드 (dev-plan P0-6).
# 백엔드가 준비되기 전까지 true. 실 API 를 붙일 때 false 로 내린다.
# 미설정 시 기본값은 true 다 — 즉 실 API 를 쓰려면 반드시 명시해야 한다.
NEXT_PUBLIC_USE_MOCK=true
